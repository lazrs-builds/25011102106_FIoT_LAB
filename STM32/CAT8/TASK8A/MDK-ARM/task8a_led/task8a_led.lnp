--cpu Cortex-M3
"task8a_led\startup_stm32f103xb.o"
"task8a_led\main.o"
"task8a_led\stm32f1xx_it.o"
"task8a_led\stm32f1xx_hal_msp.o"
"task8a_led\stm32f1xx_hal_gpio_ex.o"
"task8a_led\stm32f1xx_hal.o"
"task8a_led\stm32f1xx_hal_rcc.o"
"task8a_led\stm32f1xx_hal_rcc_ex.o"
"task8a_led\stm32f1xx_hal_gpio.o"
"task8a_led\stm32f1xx_hal_dma.o"
"task8a_led\stm32f1xx_hal_cortex.o"
